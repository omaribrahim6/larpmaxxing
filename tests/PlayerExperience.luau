local Tour=require("../src/client/CodexUI/Onboarding")
local Input=require("../src/client/CodexUI/InputPolicy")
local Layout=require("../src/client/CodexUI/Layout")
local SettingValue=require("../src/client/CodexUI/SettingValue")
local Toast=require("../src/client/CodexUI/ToastPolicy")
local Model=require("../src/client/CodexUI/Model")
local count=0
local function test(name,fn) fn() count+=1 print("PASS "..name) end
local STEPS={{id="look",done="next"},{id="run",done="sprint"},{id="grab",done="collect",count=2},{id="map",done="visit",modal="map"},{id="fight",done="match"},{id="end",done="next"}}
test("tour waits for the profile",function() local g=Tour.new(STEPS) assert(g:Step()==nil and not g:Finished()) end)
test("a new player starts at the top",function() local g=Tour.new(STEPS) assert(g:Load(0,false)) assert(g:Step().id=="look" and g:Index()==1 and g:Count()==6) end)
test("a rejoin carries on where it left off",function() local g=Tour.new(STEPS) g:Load(3,false) assert(g:Step().id=="map" and g:Done()==3) end)
test("finished and seasoned players never see it",function() local g=Tour.new(STEPS) assert(not g:Load(0,true)) assert(g:Step()==nil and g:Finished()) assert(not Tour.new(STEPS):Load(6,false)) end)
test("junk saved progress starts from the top",function() local g=Tour.new(STEPS) g:Load(0/0,false) assert(g:Step().id=="look") end)
test("the profile loads the tour once",function() local g=Tour.new(STEPS) g:Load(0,false) g:Load(4,true) assert(g:Step().id=="look") end)
test("look steps finish on Next",function() local g=Tour.new(STEPS) g:Load(0,false) assert(g:CanNext(0)) assert(g:Next(0)) assert(g:Step().id=="run") end)
test("do steps wait for the doing",function() local g=Tour.new(STEPS,15) g:Load(1,false) g:Update({},0) assert(not g:CanNext(1) and not g:Next(1)) assert(g:Update({sprinting=true},2)) assert(g:Step().id=="grab") end)
test("a stuck step offers Next after a while",function() local g=Tour.new(STEPS,15) g:Load(1,false) g:Update({},100) assert(not g:CanNext(114)) assert(g:CanNext(115) and g:Next(115)) assert(g:Step().id=="grab") end)
test("props count only on the prop step",function() local g=Tour.new(STEPS) g:Load(1,false) assert(not g:Collected()) g:Update({sprinting=true},0) assert(not g:Collected() and g.count==1) assert(g:Collected()) assert(g:Step().id=="map") end)
test("a panel step needs opening then closing",function() local g=Tour.new(STEPS) g:Load(3,false) assert(not g:Update({open={map=false}},0)) assert(not g:Update({open={map=true}},1)) assert(g:Update({open={map=false}},2)) assert(g:Step().id=="fight") end)
test("a larp-off step waits out the result card",function() local g=Tour.new(STEPS) g:Load(4,false) assert(not g:Update({inMatch=false},0)) g:Update({inMatch=true},1) assert(not g:Update({inMatch=false},2)) assert(not g:Update({inMatch=false,celebrating=true},4)) assert(g:Update({inMatch=false},4)) assert(g:Step().id=="end") end)
test("the last Next ends it",function() local g=Tour.new(STEPS) g:Load(5,false) assert(g:Next(0)) assert(g:Finished() and g:Step()==nil and g:Done()==6) end)
test("skip ends it and a replay starts over unsaved",function() local g=Tour.new(STEPS) g:Load(2,false) g:Skip() assert(g:Finished()) g:Restart() assert(g:Step().id=="look" and g.replaying) g:Skip() assert(not g.replaying and g:Finished()) end)
test("the Guide button mid first run starts over and still saves",function() local g=Tour.new(STEPS) g:Load(3,false) g:Restart() assert(g:Step().id=="look" and not g.replaying) end)
test("the Guide button before the profile does nothing",function() local g=Tour.new(STEPS) g:Restart() assert(g:Step()==nil) g:Load(3,false) assert(g:Step().id=="map") end)
test("tour progress is a setting that goes past 1",function() local model=Model.new({Settings={{key="tourStep",default=0,persisted=true,max=100}}}) assert(model:SetSetting("tourStep",7)) assert(not model:SetSetting("tourStep",101)) assert(not model:SetSetting("tourStep",-1)) end)
test("world controls pass through",function() for _,key in {"E","ButtonX","ButtonA","Space"} do assert(Input.route(key,{})==nil) end end)
test("typing menu and matches never captured",function() for _,ctx in {{typing=true},{menu=true},{inMatch=true}} do for _,key in {"G","Y","N","ButtonY","ButtonB"} do assert(Input.route(key,ctx)==nil) end end end)
test("keyboard challenge routing",function() assert(Input.route("Y",{challenge=true})=="accept") assert(Input.route("N",{challenge=true})=="decline") assert(Input.route("G",{challenge=true})==nil) end)
test("gamepad B dismisses modal only",function() assert(Input.route("ButtonB",{})==nil) assert(Input.route("ButtonB",{settings=true})=="close") assert(Input.route("ButtonB",{challenge=true})=="decline") end)
test("gamepad Y cannot accidentally accept",function() assert(Input.route("ButtonY",{})=="settings") assert(Input.route("ButtonY",{challenge=true})==nil) end)
test("keyboard focus is scoped to modals",function() assert(Input.route("Tab",{})==nil) assert(Input.route("Tab",{settings=true})=="focus") assert(Input.route("Return",{challenge=true})=="activate") assert(Input.route("Return",{typing=true,challenge=true})==nil) end)
test("arrow alternatives avoid the reserved Tab key",function() assert(Input.route("Down",{settings=true})=="focusNext") assert(Input.route("Up",{challenge=true})=="focusPrevious") assert(Input.route("Up",{})==nil) end)
test("focus wraps and starts correctly in both directions",function() assert(Input.nextIndex(nil,7,false)==1) assert(Input.nextIndex(nil,7,true)==7) assert(Input.nextIndex(1,7,true)==7) assert(Input.nextIndex(7,7,false)==1) assert(Input.nextIndex(nil,0,false)==nil) end)
test("volume steps in both directions",function() assert(SettingValue.next({step=.25},.5,1)==.75) assert(SettingValue.next({step=.25},.5,-1)==.25) end)
test("volume boundaries never wrap",function() assert(SettingValue.next({step=.25},1,1)==1) assert(SettingValue.next({step=.25},0,-1)==0) end)
test("invalid volume arguments rejected",function() assert(SettingValue.next({step=.25},0/0,1)==nil) assert(SettingValue.next({step=.25},.5,100)==nil) end)
test("boolean settings retain toggle API",function() assert(SettingValue.next({},true)==false) assert(SettingValue.next({},false)==true) end)
test("persisted numeric preferences hydrate from server profile",function()
	local model=Model.new({Settings={{key="musicVolume",default=1,persisted=true},{key="showCosmetics",default=true,persisted=true}}})
	assert(model:SetProfile({stats={Bag=1},total=1,wins=0,settings={musicVolume=.35,showCosmetics=false}}))
	assert(model.settings.musicVolume==.35 and model.settings.showCosmetics==false)
	model:SetProfile({stats={Bag=2},total=2,wins=0})
	assert(model.settings.musicVolume==.35 and model.settings.showCosmetics==false)
	local valid,persisted=model:SetSetting("musicVolume",.6) assert(valid and persisted)
end)
test("toast truncation preserves Unicode",function() local s=Toast.text("é🐈你好hello",5) assert(utf8.len(s)==5 and s=="é🐈你好…") end)
test("malformed and empty notices rejected",function() assert(Toast.text(string.char(255),240)==nil) assert(Toast.text("",240)==nil) assert(Toast.text(string.rep("a",17000),240)==nil) end)
test("pickup bursts preserve warning notices",function() local accepted,index=Toast.admit({{kind="warning"},{kind="success"},{kind="error"}},"success",3) assert(accepted and index==2) end)
test("full warning queue rejects incidental notices",function() assert(not Toast.admit({{kind="warning"},{kind="error"}},"success",2)) local accepted,index=Toast.admit({{kind="error"}},"warning",1) assert(accepted and index==1) end)
test("long notices have bounded reading time",function() assert(Toast.duration("hello",4)==4) assert(Toast.duration(string.rep("a",240),4)==10) end)
test("toast stacks stay inside viewport",function() local offsets=Toast.stack({100,100,100},220,6) assert(offsets[3]==0 and offsets[2]==-106 and offsets[1]==false) end)
test("toast whitespace cannot create unbounded height",function() assert(Toast.text(" a\n\n\tb ",240)=="a b") assert(Toast.text("\n\t ",240)==nil) end)
test("important notices retain visible stack priority",function() assert(Toast.insertionIndex({{kind="info"},{kind="warning"}},"success")==2) assert(Toast.insertionIndex({{kind="warning"}},"error")==2) end)
test("match deferral preserves remaining reading time",function() assert(Toast.resumedDeadline(104,100,102,120)==122) end)
test("notices arriving during match receive a full reading window",function() assert(Toast.resumedDeadline(114,110,102,120)==124) end)
for _,viewport in {{320,480},{360,640},{640,320},{844,350},{1024,768},{1920,1080}} do
	test("viewport "..viewport[1].."x"..viewport[2],function()
		local rects=Layout.compute(viewport[1],viewport[2])
		for _,r in rects do assert(r.x>=0 and r.y>=0 and r.x+r.w<=viewport[1]+.01 and r.y+r.h<=viewport[2]+.01) end
		assert(rects.rematch.h>=44)
		assert(rects.settings.h-120>=100,"usable scrolling region")
	end)
end
print(tostring(count).." player experience tests passed")
